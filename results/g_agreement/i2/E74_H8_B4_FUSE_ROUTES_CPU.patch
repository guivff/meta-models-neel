+"""Build FUSE admission from actual pod metadata and numbered read-only SSH.
+
+No provider calls, SSH calls, filesystem mutation or allocation occur here.
+The enclosing preparer validates transport ownership, the allocator's true exit,
+the original guard pair, dated budgets and the bound source hashes separately.
+"""
+import hashlib
+import json
+import importlib.util
+from pathlib import Path
+_spec=importlib.util.spec_from_file_location('bound_fuse_policy',Path(__file__).with_name('storage_policy.py'))
+policy=importlib.util.module_from_spec(_spec);_spec.loader.exec_module(policy)
+
+
+def probe_source(allocation, sequence):
+    """Read only mount metadata, byte usage and free space, under setup900."""
+    policy.require(type(sequence) is int and sequence > 0, 'numbered observation required')
+    identity = allocation['identity_sha256']
+    end = allocation['original_setup_deadline_epoch']
+    return (
+        'import json,subprocess,shutil,time\n'
+        f'identity={identity!r}; end={end!r}; sequence={sequence!r}\n'
+        'assert time.time()<end\n'
+        'def read(argv):\n'
+        ' r=subprocess.run(argv,check=True,stdout=subprocess.PIPE,stderr=subprocess.PIPE,timeout=max(.01,end-time.time()))\n'
+        ' assert len(r.stdout)<=262144 and time.time()<end\n'
+        ' return r.stdout\n'
+        "mount=json.loads(read(['findmnt','-J','-T','/workspace','-o','SOURCE,TARGET,FSTYPE']))\n"
+        "used=int(read(['du','-sx','-B1','/workspace']).split()[0])\n"
+        "free=shutil.disk_usage('/workspace').free\n"
+        "print(json.dumps(dict(schema='E74_STORAGE_READONLY_V1',run_identity_sha256=identity,sequence=sequence,checked_epoch=time.time(),original_setup_deadline_epoch=end,findmnt=mount,existing_volume_bytes=used,free_bytes=free)))\n"
+    )
+
+
+def build(allocation_raw, provider_raw, observation_raw, sequence, now):
+    a = json.loads(allocation_raw)
+    response = json.loads(provider_raw)
+    policy.require(not response.get('errors'), 'provider query failed')
+    pod = response['data']['pod']
+    obs = json.loads(observation_raw)
+    required = {'schema', 'run_identity_sha256', 'sequence', 'checked_epoch',
+                'original_setup_deadline_epoch', 'findmnt', 'existing_volume_bytes', 'free_bytes'}
+    policy.require(set(obs) == required and obs['schema'] == 'E74_STORAGE_READONLY_V1',
+                   'actual read-only storage observation required')
+    policy.require(type(sequence) is int and sequence > 0 and type(obs['sequence']) is int and obs['sequence'] == sequence,
+                   'fresh numbered storage observation required')
+    policy.require(obs['run_identity_sha256'] == a['identity_sha256'] and
+                   obs['original_setup_deadline_epoch'] == a['original_setup_deadline_epoch'],
+                   'observation belongs to another allocation')
+    policy.require(pod['id'] == a['pod_id'] and pod['name'] == a['run_id'] and
+                   pod['desiredStatus'] == 'RUNNING', 'actual running allocation required')
+    policy.require(pod['containerDiskInGb'] == a['container_disk_gb'] and
+                   pod['volumeInGb'] == a['local_volume_gb'] and
+                   pod.get('networkVolumeId') is None and a['network_volume_id'] is None,
+                   'actual provider volume differs from allocation')
+    policy.require(type(pod['volumeInGb']) is int and pod['volumeInGb'] > 0,
+                   'actual allocated volume capacity required')
+    policy.require(a['created_epoch'] <= obs['checked_epoch'] <= now <
+                   a['original_setup_deadline_epoch'] <= a['created_epoch'] + 900,
+                   'original setup clock expired or observation invalid')
+    policy.require(a['provider_stop_epoch'] - a['created_epoch'] ==
+                   a['original_full_forecast_seconds'], 'whole clock changed')
+    # Whole-run minus the original setup allowance covers weights, all science,
+    # forecast wait and closeout. Worker ops.budget also checks its actual phases.
+    remaining = a['original_full_forecast_seconds'] - 900
+    contract = dict(authority_sha256=policy.AUTHORITY_SHA256,
+        allocation_receipt_sha256=hashlib.sha256(allocation_raw).hexdigest(),
+        run_identity_sha256=a['identity_sha256'], allocation_start_epoch=a['created_epoch'],
+        provider_stop_epoch=a['provider_stop_epoch'], provider='RunPod',
+        volume_mount_path='/workspace', allocated_volume_bytes=pod['volumeInGb'] * 1_000_000_000,
+        existing_volume_bytes=obs['existing_volume_bytes'],
+        capacity_observed_epoch=obs['checked_epoch'], remaining_seconds=remaining)
+    admission = dict(storage_exception=contract,
+        allocation_receipt_sha256=contract['allocation_receipt_sha256'],
+        run_identity_sha256=a['identity_sha256'], allocation_start_epoch=a['created_epoch'],
+        provider_stop_epoch=a['provider_stop_epoch'], replica_hourly_usd=a['replica_hourly_usd'],
+        other_cost_upper_bound_usd=float(a['extras_upper_usd']), cap_usd=a['cap_usd'])
+    proof = policy.contract(admission, obs['findmnt'], obs['free_bytes'],
+                            policy.MIN_REQUIRED_BYTES, now)
+    return {'contract': contract, 'preflight_proof': proof,
+            'provider_observation_sha256': hashlib.sha256(provider_raw).hexdigest(),
+            'storage_observation_sha256': hashlib.sha256(observation_raw).hexdigest(),
+            'probe_source_sha256': hashlib.sha256(probe_source(a, sequence).encode()).hexdigest(),
+            'sequence': sequence, 'original_clocks_unchanged': True,
+            'local_nvme_verified': False}
